@model Expense_Tracker.Models.Expense
@{
    ViewBag.Title = "Expense Details";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4">
            <div class="d-flex justify-content-between align-items-start mb-4 pb-3 border-bottom">
                <div>
                    <span class="badge-category mb-2" style="background-color: @Model.CategoryColor; color: white;">
                        <i class="bi @Model.CategoryIcon"></i> @Model.CategoryName
                    </span>
                    <h3 class="fw-bold mb-0">@Model.Title</h3>
                </div>
                <div class="text-end">
                    <small class="text-muted text-uppercase fw-semibold d-block">Amount</small>
                    <span class="fs-3 fw-bold text-danger">₹@Model.Amount.ToString("N2")</span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold">Date of Expense</small>
                        <div class="fw-semibold mt-1">@Model.ExpenseDate.ToString("dddd, MMMM dd, yyyy")</div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold">Payment Method</small>
                        <div class="fw-semibold mt-1"><i class="bi bi-credit-card-2-front me-1"></i> @Model.PaymentMethod</div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold">Notes / Description</small>
                        <div class="mt-1">
                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                @Model.Notes
                            }
                            else
                            {
                                <em class="text-muted">No notes provided for this expense.</em>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2">
                <a href="@Url.Action("Index", "Expense")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("Edit", "Expense", new { id = Model.ExpenseId })" class="btn btn-primary-custom">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    @using (Html.BeginForm("Delete", "Expense", new { id = Model.ExpenseId }, FormMethod.Post, new { onsubmit = "return confirm('Are you sure you want to delete this expense?');" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-trash me-1"></i> Delete
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
