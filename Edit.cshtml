@model Expense_Tracker.Models.Expense
@{
    ViewBag.Title = "Edit Expense";
}

<div class="row justify-content-center py-3">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4">
            <div class="d-flex align-items-center gap-3 mb-4 pb-2 border-bottom">
                <div class="p-3 rounded-circle bg-warning-subtle text-warning">
                    <i class="bi bi-pencil-square fs-3"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">Edit Expense</h4>
                    <p class="text-muted small mb-0">Modify details of transaction #@Model.ExpenseId</p>
                </div>
            </div>

            @using (Html.BeginForm("Edit", "Expense", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ExpenseId)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Title, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        @Html.LabelFor(m => m.Amount, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            <span class="input-group-text bg-light">₹</span>
                            @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-sm-6">
                        @Html.LabelFor(m => m.CategoryId, new { @class = "form-label fw-semibold" })
                        @Html.DropDownListFor(m => m.CategoryId, (SelectList)ViewBag.CategoryId, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        @Html.LabelFor(m => m.ExpenseDate, new { @class = "form-label fw-semibold" })
                        <input type="date" name="ExpenseDate" value="@(Model.ExpenseDate.ToString("yyyy-MM-dd"))" class="form-control" />
                        @Html.ValidationMessageFor(m => m.ExpenseDate, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-sm-6">
                        @Html.LabelFor(m => m.PaymentMethod, new { @class = "form-label fw-semibold" })
                        <select name="PaymentMethod" class="form-select">
                            <option value="Credit Card" @(Model.PaymentMethod == "Credit Card" ? "selected" : "")>Credit Card</option>
                            <option value="Debit Card" @(Model.PaymentMethod == "Debit Card" ? "selected" : "")>Debit Card</option>
                            <option value="UPI" @(Model.PaymentMethod == "UPI" ? "selected" : "")>UPI</option>
                            <option value="Net Banking" @(Model.PaymentMethod == "Net Banking" ? "selected" : "")>Net Banking</option>
                            <option value="Cash" @(Model.PaymentMethod == "Cash" ? "selected" : "")>Cash</option>
                        </select>
                        @Html.ValidationMessageFor(m => m.PaymentMethod, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="mb-4">
                    @Html.LabelFor(m => m.Notes, new { @class = "form-label fw-semibold" })
                    @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = "3" })
                    @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger small" })
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a href="@Url.Action("Index", "Expense")" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="bi bi-check-lg me-1"></i> Update Expense
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
