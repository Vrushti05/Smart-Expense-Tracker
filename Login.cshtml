@model Expense_Tracker.Models.LoginViewModel
@{
    ViewBag.Title = "Sign In";
}

<div class="row justify-content-center py-5">
    <div class="col-md-5 col-lg-4">
        <div class="card card-custom p-4 p-md-5 border-0 shadow-lg">
            <div class="text-center mb-4">
                <div class="d-inline-flex p-3 rounded-4 bg-primary-subtle text-primary mb-3 shadow-sm">
                    <i class="bi bi-wallet2 fs-2"></i>
                </div>
                <h3 class="fw-bold mb-1">Welcome Back</h3>
                <p class="text-muted small">Sign in to your Client or Admin Portal</p>
            </div>

            @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "needs-validation" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold small text-muted text-uppercase" })
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-start-0 ps-0", placeholder = "name@example.com", autofocus = "autofocus", id = "loginEmail" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label fw-semibold small text-muted text-uppercase" })
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key"></i></span>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control border-start-0 ps-0", placeholder = "••••••••", id = "loginPassword" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary-custom py-2 justify-content-center">
                        <i class="bi bi-box-arrow-in-right"></i> Sign In to Portal
                    </button>
                </div>
            }

            <!-- Quick One-Click Credentials Autofill for Client & Admin -->
            <div class="card border-0 bg-light p-3 mt-4 rounded-3 small">
                <div class="fw-bold text-dark mb-2"><i class="bi bi-shield-lock text-primary me-1"></i> Quick Demo Logins:</div>
                <div class="d-flex flex-column gap-2">
                    <button type="button" class="btn btn-sm btn-outline-primary text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('john@example.com', 'demo123')">
                        <span><i class="bi bi-person me-1"></i> <strong>Client:</strong> john@example.com</span>
                        <span class="badge bg-primary">Auto-fill</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('admin@smarttracker.com', 'admin123')">
                        <span><i class="bi bi-shield-check me-1"></i> <strong>Admin:</strong> admin@smarttracker.com</span>
                        <span class="badge bg-danger">Auto-fill</span>
                    </button>
                </div>
            </div>

            <div class="text-center mt-4 text-muted small">
                Don't have an account yet? 
                <a href="@Url.Action("Register", "Account")" class="text-primary fw-bold text-decoration-none ms-1">Create an account</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function fillCredentials(email, pass) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = pass;
        }
    </script>
}
