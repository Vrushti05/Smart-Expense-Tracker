@model Expense_Tracker.Models.User
@{
    ViewBag.Title = "User Profile";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7">
        <div class="card card-custom p-4">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fs-2" style="width: 60px; height: 60px; font-weight: 700;">
                    @Model.FullName.Substring(0, 1).ToUpper()
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="fw-bold mb-0">@Model.FullName</h4>
                        <span class="badge @(Model.IsAdmin ? "bg-danger" : "bg-primary") rounded-pill">
                            @Model.Role
                        </span>
                    </div>
                    <p class="text-muted mb-0">@Model.Email</p>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold">Member Since</small>
                        <div class="fs-6 fw-semibold mt-1">@Model.CreatedAt.ToString("MMMM dd, yyyy")</div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold">Current Monthly Income</small>
                        <div class="fs-5 fw-bold text-success mt-1">₹@Model.MonthlyIncome.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <h5 class="fw-bold mb-3"><i class="bi bi-pencil-square me-2 text-primary"></i>Update Monthly Income</h5>
            <p class="text-muted small">Update your baseline income so that the Smart Insights and Savings Rate metrics reflect your current financial scenario.</p>

            @using (Html.BeginForm("UpdateIncome", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-semibold">Monthly Income (₹)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light">₹</span>
                        <input type="number" step="100" min="0" name="monthlyIncome" class="form-control" value="@Model.MonthlyIncome" required />
                        <button type="submit" class="btn btn-primary-custom">Update Income</button>
                    </div>
                </div>
            }

            <div class="mt-4 pt-3 border-top d-flex justify-content-between">
                <a href="@Url.Action("Index", Model.IsAdmin ? "Admin" : "Dashboard")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
                <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </a>
            </div>
        </div>
    </div>
</div>
